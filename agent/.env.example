# ---- Mantle network ----
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz

# ---- Agent signer (must hold an ERC-8004 Agent Identity NFT) ----
AGENT_PRIVATE_KEY=0xyour_agent_burner_private_key

# ---- Deployed contract addresses (from forge script output) ----
VAULT_ADDRESS=0x...
METH_ADDRESS=0x...
USDY_ADDRESS=0x...

# ---- LLM inference (OpenAI-compatible) ----
# Option A — OpenAI:
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=            # leave empty for OpenAI
#
# Option B — Google Gemini (OpenAI-compatible endpoint):
#   OPENAI_API_KEY=<your Gemini API key>
#   OPENAI_MODEL=gemini-2.5-flash
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ---- Loop / output ----
LOOP_INTERVAL_SECONDS=180
STATUS_JSON_PATH=../frontend/public/status.json

# ---- Cloud push (optional) ----
# Push status to a deployed frontend instead of (or in addition to) the local
# file. Point at the deployed dashboard's /api/status route.
STATUS_PUSH_URL=
AGENT_PUSH_SECRET=

# ---- Economics (tune to make the demo trade more/less often) ----
# Mocked flat gas cost per rebalance. Mantle L2 is cheap (~$0.01-0.05).
# Lower this => trades clear the gas-vs-yield check more easily.
ESTIMATED_GAS_USD=0.05

# Timeouts (seconds) — prevent indefinite hangs on slow RPC / LLM / tx receipt
RPC_TIMEOUT_SECONDS=15
LLM_TIMEOUT_SECONDS=30
TX_RECEIPT_TIMEOUT_SECONDS=45

# Smoothing so the AI target glides instead of teleporting (0..1, lower = smoother).
SIGNAL_INERTIA=0.35
TARGET_INERTIA=0.5
